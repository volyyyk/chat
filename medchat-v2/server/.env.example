# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medchat_v2
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Keys
ENCRYPTION_SECRET=your-encryption-secret-key

# File Storage (MinIO)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medchat-files
FILE_RETENTION_DAYS=3

# Payment Systems
YOOMONEY_REDIRECT_URI=http://localhost:3000/api/payments/yookassa/callback
YOOMONEY_SHOP_ID=your-shop-id
YOOMONEY_SECRET_KEY=your-secret-key

TINKOFF_TERMINAL_KEY=your-terminal-key
TINKOFF_PASSWORD=your-password
TINKOFF_MERCHANT_ID=your-merchant-id

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Micropayment Configuration
FREE_MESSAGE_DAYS=30
MESSAGE_PRICE_RUB=50
DOCTOR_SHARE_PERCENT=80
CLINIC_SHARE_PERCENT=20

# WebSocket Configuration
WS_PORT=3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/medchat.log

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:19006

# Session
SESSION_SECRET=your-session-secret

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=medchat@example.com

# SMS (for 2FA)
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# Clinic Verification
CLINIC_VERIFICATION_ENABLED=true

# Legal
TERMS_OF_SERVICE_URL=http://localhost:3000/terms
PRIVACY_POLICY_URL=http://localhost:3000/privacy
