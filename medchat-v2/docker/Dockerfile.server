# Local development image only. Production uses ../server/Dockerfile.
FROM node:22-alpine

WORKDIR /app/server

# Install the full development toolchain (including nodemon for npm run dev).
COPY server/package*.json ./
RUN npm install --no-audit --no-fund

# The build context is medchat-v2/. Never copy .env or credentials into an image.
COPY server/ ./

RUN mkdir -p logs

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000
CMD ["npm", "run", "dev"]
