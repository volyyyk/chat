{
  "name": "medchat-v2",
  "version": "2.0.1",
  "description": "MedChat v2.0 - Doctor-Patient Communication Platform with Micropayments",
  "private": true,
  "scripts": {
    "setup": "npm run setup:server && npm run setup:mobile && npm run setup:web",
    "setup:server": "cd server && npm install",
    "setup:mobile": "cd mobile && npm install",
    "setup:web": "cd web && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd server && npm run dev",
    "dev:web": "cd web && npm run dev",
    "build": "npm run build:server && npm run build:mobile && npm run build:web",
    "build:server": "cd server && npm run build",
    "build:mobile": "cd mobile && npm run build",
    "build:web": "cd web && npm run build",
    "start": "cd server && npm start",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "db:migrate": "cd server && npm run db:migrate",
    "db:seed": "cd server && npm run db:seed",
    "lint": "npm run lint:server && npm run lint:mobile && npm run lint:web",
    "test": "npm run test:server && npm run test:mobile",
    "test:server": "cd server && npm test",
    "test:mobile": "cd mobile && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "medchat",
    "doctor",
    "patient",
    "healthcare",
    "messaging",
    "micropayments",
    "telemedicine"
  ],
  "author": "",
  "license": "MIT"
}
