# Канонический тест-вектор NaCl crypto_box (public domain).
# Источник: дистрибуция NaCl (nacl.cryp.to/box.html), воспроизведена в
# rbnacl test_vectors.rb (RubyCrypto/rbnacl) и nacl.cr.yp.to.
#
# c = crypto_box(m, nonce, bob_pk, alice_sk) — отправитель Alice, получатель Bob.
# Общая фикстура кросс-платформенного контракта E2E-конверта x25519-box
# (Этап 2 DoD, docs/ROADMAP_NATIVE.md):
#   - Rust-ядро:   core/tests/interop_vectors.rs (SalsaBox, crypto_box 0.9)
#   - JS-сторона:  server/tests/coreInterop.test.js (tweetnacl, как в mobile)
# Обе реализации обязаны совпадать с эталоном байт-в-байт.
alice_sk = 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a
alice_pk = 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
bob_sk = 5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb
bob_pk = de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f
nonce = 69696ee955b62b73cd62bda875fc73d68219e0036b7a0b37
m = be075fc53c81f2d5cf141316ebeb0c7b5228c52a4c62cbd44b66849b64244ffce5ecbaaf33bd751a1ac728d45e6c61296cdc3c01233561f41db66cce314adb310e3be8250c46f06dceea3a7fa1348057e2f6556ad6b1318a024a838f21af1fde048977eb48f59ffd4924ca1c60902e52f0a089bc76897040e082f937763848645e0705
