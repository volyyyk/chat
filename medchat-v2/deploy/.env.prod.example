# MedChat: пример окружения для прода (инструкция — ../docs/DEPLOY.md).
#   cp .env.prod.example .env.prod  — и заполнить все CHANGE_ME значения.
# .env.prod живёт только на хосте: НЕ коммитить в git.

NODE_ENV=production
PORT=3000

# PostgreSQL (внутри compose — сервис postgres; для managed-Postgres — его host/port
# и убрать DB_SSL=false из docker-compose.prod.yml — там по умолчанию ssl require)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=medchat_v2
DB_USER=medchat
DB_PASSWORD=CHANGE_ME_надёжный_пароль
DB_DIALECT=postgres
DB_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT и шифрование: сгенерируйте openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_SECRET=CHANGE_ME_openssl_rand_hex_32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# MinIO (файловое хранилище, бакет medchat-files)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=medchat-files
FILE_RETENTION_DAYS=3

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS: origin веб-клиента (за nginx — ваш домен, например https://medchat.example.com)
CORS_ORIGIN=http://localhost
TRUST_PROXY=1

# Логирование
LOG_LEVEL=info

# Микроплатежи
FREE_MESSAGE_DAYS=30
MESSAGE_PRICE_RUB=50
DOCTOR_SHARE_PERCENT=80
CLINIC_SHARE_PERCENT=20

# Платёжные шлюзы (если не используются — оставьте плейсхолдеры)
YOOMONEY_REDIRECT_URI=http://localhost/api/payments/yookassa/callback
YOOMONEY_SHOP_ID=CHANGE_ME
YOOMONEY_SECRET_KEY=CHANGE_ME
TINKOFF_TERMINAL_KEY=CHANGE_ME
TINKOFF_PASSWORD=CHANGE_ME
TINKOFF_MERCHANT_ID=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_PUBLISHABLE_KEY=CHANGE_ME

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=medchat@example.com

# SMS для 2FA — оператор (149-ФЗ): ключи в репо не входят
SMS_API_KEY=CHANGE_ME
SMS_API_SECRET=CHANGE_ME

CLINIC_VERIFICATION_ENABLED=true
TERMS_OF_SERVICE_URL=http://localhost/terms
PRIVACY_POLICY_URL=http://localhost/privacy